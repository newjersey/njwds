{
  "name": "grove-monorepo",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint",
    "sass:dev": "npm run sass:dev -w packages/njwds",
    "sass:build": "npm run sass:build -w packages/njwds",
    "web-components:build": "npm run web-components:build -w packages/njwds",
    "storybook": "npm run storybook -w packages/njwds",
    "storybook:build": "npm run storybook:build -w packages/njwds",
    "tokens:build": "npm run tokens:build -w packages/tokens",
    "tokens:test": "npm run tokens:test -w packages/tokens",
    "tokens:dryrun": "npm publish --dry-run --workspace=packages/tokens",
    "preview": "npm run preview -w packages/njwds",
    "test": "npm run test -w packages/njwds",
    "test:coverage": "npm run test:coverage -w packages/njwds",
    "test:coverage:ci": "npx playwright install --with-deps chromium && npm run test:coverage",
    "test:visual": "npm run test:visual -w packages/njwds",
    "test:accessibility": "npm run test:accessibility -w packages/njwds",
    "test:accessibility:ci": "npm run sass:build && npm run storybook:build && npm run test:accessibility",
    "test:visual:update": "npm run test:visual:update -w packages/njwds",
    "import-components": "npm run import-components -w packages/njwds"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@html-eslint/eslint-plugin": "^0.66.1",
    "@types/node": "^26.6.3",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-lit": "^2.1.1",
    "eslint-plugin-lit-a11y": "^5.1.1",
    "eslint-plugin-wc": "^3.1.0",
    "globals": "^17.0.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1"
  },
  "lint-staged": {
    "**/*": "prettier --write --ignore-unknown"
  },
  "overrides": {
    "postcss": "^8.3.11",
    "got": "^12.1.0",
    "braces": "^3.0.3",
    "inquirer": {
      "lodash": "^4.17.19"
    }
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
