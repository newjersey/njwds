{
  "name": "@newjersey/njwds",
  "version": "2.11.1",
  "description": "NJ Web Design Standards",
  "main": "index.js",
  "type": "module",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./web-components/*": {
      "types": "./dist/web-components/*/index.d.ts",
      "default": "./dist/web-components/*/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./*": "./*"
  },
  "scripts": {
    "prepare": "npm run grove:build",
    "import-components": "cp -nr node_modules/uswds/src/components ./src/",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:visual": "playwright test --project=visual",
    "test:accessibility": "playwright test --project=accessibility",
    "test:visual:update": "playwright test --project=visual --update-snapshots=all",
    "grove:dev": "vite build --config vite.config.grove.ts --watch",
    "grove:build": "vite build --config vite.config.grove.ts && vite build --config vite.config.grove-cdn.ts && npm run grove:build:types",
    "grove:build:types": "tsc -p tsconfig.components.json",
    "preview": "npx serve storybook-static",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/newjersey/njwds.git"
  },
  "author": "New Jersey Innovation Authority",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/newjersey/njwds/issues"
  },
  "homepage": "https://github.com/newjersey/njwds#readme",
  "sideEffects": [
    "**/*.css",
    "**/web-components/**",
    "./index.js"
  ],
  "dependencies": {
    "@newjersey/feedback-widget": "^0.8.3",
    "@uswds/uswds": "3.14.0",
    "lit": "^3.3.2"
  },
  "peerDependencies": {
    "@lit/react": "^1.0.8",
    "react": ">=16.8"
  },
  "peerDependenciesMeta": {
    "@lit/react": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@lit/react": "^1.0.8",
    "@playwright/test": "^1.64.1",
    "@storybook/addon-a11y": "^10.6.5",
    "@storybook/addon-docs": "^10.6.5",
    "@storybook/addon-vitest": "^10.6.5",
    "@storybook/web-components-vite": "^10.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/browser": "^5.0.3",
    "@vitest/browser-playwright": "^5.0.3",
    "@vitest/coverage-v8": "^5.0.3",
    "autoprefixer": "^10.6.2",
    "jsdom": "^30.1.3",
    "playwright": "^1.64.0",
    "postcss": "^8.5.32",
    "postcss-csso": "^6.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sass": "^1.107.1",
    "storybook": "^10.6.3",
    "vite": "^8.3.5"
  },
  "files": [
    "dist",
    "src",
    "index.js",
    "index.d.ts",
    "package.json",
    ".browserslistrc"
  ]
}
