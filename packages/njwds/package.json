{
  "name": "@newjersey/njwds",
  "version": "2.11.0",
  "description": "NJ Web Design Standards",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "prepare": "npm run build",
    "build": "npm run sass:build && npm run web-components:build",
    "import-components": "cp -nr node_modules/uswds/src/components ./src/",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:visual": "playwright test --project=visual",
    "test:accessibility": "playwright test --project=accessibility",
    "test:visual:update": "playwright test --project=visual --update-snapshots=all",
    "sass:dev": "vite build --config vite.config.sass.ts --watch",
    "sass:build": "vite build --config vite.config.sass.ts",
    "web-components:build": "vite build --config vite.config.web-components.ts",
    "preview": "npx serve storybook-static",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/newjersey/njwds.git"
  },
  "author": "New Jersey Innovation Authority",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/newjersey/njwds/issues"
  },
  "homepage": "https://github.com/newjersey/njwds#readme",
  "sideEffects": [
    "**/*.css",
    "./dist/components/**",
    "./src/components/**"
  ],
  "dependencies": {
    "@newjersey/feedback-widget": "^0.7.1",
    "@uswds/uswds": "3.14.0",
    "lit": "^3.3.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/addon-vitest": "^10.6.1",
    "@storybook/web-components-vite": "^10.6.1",
    "@vitest/browser": "^5.0.3",
    "@vitest/browser-playwright": "^5.0.3",
    "@vitest/coverage-v8": "^5.0.3",
    "autoprefixer": "^10.6.1",
    "jsdom": "^30.1.2",
    "playwright": "^1.58.2",
    "postcss": "^8.5.28",
    "postcss-csso": "^6.0.1",
    "sass": "^1.105.1",
    "storybook": "^10.2.13",
    "vite": "^8.3.3"
  },
  "files": [
    "dist",
    "src",
    "package.json",
    ".browserslistrc"
  ]
}
